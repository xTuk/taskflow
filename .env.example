# =============================================================================
# TaskFlow — environment variables
# Copy this file to .env (for local dev) and fill in real values.
# Never commit the real .env file — it is already in .gitignore.
# =============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by Prisma. Works with any Postgres host:
# a local Docker container, a local Postgres install, or a hosted instance
# such as Neon (https://neon.tech). Neon connection strings look like:
#   postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/taskflow?sslmode=require
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public"

# --- Auth ---------------------------------------------------------------
# Secret used to sign and verify JWT session tokens. Must be a long, random
# string in production. Generate one with: openssl rand -base64 32
JWT_SECRET="replace-this-with-a-long-random-string"

# --- AWS S3 (file attachments) ----------------------------------------------
# Used to generate presigned URLs so the browser can upload attachments
# directly to S3. If these are left unset, the app still builds and runs —
# the upload UI will simply show a "File uploads are not configured" message
# instead of crashing.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
